[Unit]
Description=AutoKP Mini App (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/autokpbot/backend
ExecStart=/opt/autokpbot/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
